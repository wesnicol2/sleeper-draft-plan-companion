# Copy to .env before `docker compose up -d`. Never commit .env.

# Host ports for the two environments. Pick a pair that nothing else on the
# server is already using -- the template ships
# the same defaults, so the second one you deploy will collide.
PROD_PORT=8082
TEST_PORT=8083

# Container timezone. Defaults to UTC if unset.
TZ=America/New_York

# Application config goes below. Anything secret lives here and only here.

# Which draft to follow. SLEEPER_DRAFT_ID is the one /draft-state needs;
# SLEEPER_USERNAME is how it works out which slot is yours.
# SLEEPER_USERNAME=
# SLEEPER_DRAFT_ID=
# SLEEPER_LEAGUE_ID=

# A mock draft publishes no draft order until it starts, so your username can't
# be resolved to a slot beforehand. Set this to force it while testing.
# SLEEPER_DRAFT_SLOT=

# Sleeper's player file is ~14.6MB and they ask you not to fetch it more than
# once a day. Lower this only when you are debugging the cache itself.
# PLAYERS_TTL_SECONDS=86400
